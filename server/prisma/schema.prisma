generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   // STUDENT or MENTOR
  createdAt DateTime @default(now())

  // For Student: The mentor assigned to them
  mentorId  Int?
  mentor    User?    @relation("MentorStudents", fields: [mentorId], references: [id])
  students  User[]   @relation("MentorStudents")

  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  activities     Activity[]
}

model Course {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime     @default(now())
  
  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  order       Int
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id])

  progress    LessonProgress[]
  activities  Activity[]
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  studentId Int
  courseId  Int

  student   User     @relation(fields: [studentId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
}

model LessonProgress {
  id          Int       @id @default(autoincrement())
  studentId   Int
  lessonId    Int
  status      String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  completedAt DateTime?

  student     User      @relation(fields: [studentId], references: [id])
  lesson      Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([studentId, lessonId])
}

model Activity {
  id              Int      @id @default(autoincrement())
  studentId       Int
  lessonId        Int?
  type            String   // LESSON_OPENED, LESSON_COMPLETED, STUDY_SESSION
  durationMinutes Int      @default(0)
  createdAt       DateTime @default(now())

  student         User     @relation(fields: [studentId], references: [id])
  lesson          Lesson?  @relation(fields: [lessonId], references: [id])
}
